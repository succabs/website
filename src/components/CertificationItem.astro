---
// CertificationItem.astro
export interface Props {
  title: string;
  issuer: string;
  date: string;
  link?: string;
}

const { title, issuer, date, link } = Astro.props;
---

<div class="certification-card">
  <div class="header-bar"></div>
  <div class="content">
    <h3 class="title">{title}</h3>
    <div>
      <p class="issuer">Issued by <strong>{issuer}</strong></p>
      <p class="date">Expires on: {date}</p>

      {
        link ? (
          <a
            href={link}
            class="button"
            target="_blank"
            rel="noopener noreferrer"
          >
            View Certificate{" "}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        ) : (
          <p class="no-link">No link available</p>
        )
      }
    </div>
  </div>
  <div class="footer-bar"></div>
</div>

<style>

.certification-card { background:var(--accent-second); border:1px solid var(--color-outlines); height:100%; }
.header-bar,.footer-bar { display:none; }
.content { padding:1.5rem; display:flex; flex-direction:column; justify-content:space-between; height:100%; gap:1.5rem; }
.title { font-size:1.1rem; line-height:1.4; }
.issuer,.date { font-size:.85rem; }
.button { display:inline-block; margin-top:1rem; padding:.5rem 0; font-size:.85rem; font-weight:600; }

</style>
