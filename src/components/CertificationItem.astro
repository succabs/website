---
// CertificationItem.astro
export interface Props {
  title: string;
  issuer: string;
  date: string;
  link?: string;
}

const { title, issuer, date, link } = Astro.props;
---

<div class="certification-card">
  <div class="header-bar"></div>
  <div class="content">
    <h3 class="title">{title}</h3>
    <div>
      <p class="issuer">Issued by <strong>{issuer}</strong></p>
      <p class="date">Expires on: {date}</p>

      {
        link ? (
          <a
            href={link}
            class="button"
            target="_blank"
            rel="noopener noreferrer"
          >
            View Certificate{" "}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        ) : (
          <p class="no-link">No link available</p>
        )
      }
    </div>
  </div>
  <div class="footer-bar"></div>
</div>

<style>
  .certification-card {
    border: 3px solid var(--color-outlines-dark);
    background-color: var(--accent-second);
    color: var(--color-text-dark);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    margin-bottom: 1rem;
    position: relative;
  }

  /* top + bottom bars */
  .header-bar {
    height: 8px;
    background: var(--accent); /* red */
    border-bottom: 3px solid var(--color-outlines-dark);
    border-top: 3px solid var(--color-outlines-dark);
  }
  .footer-bar {
    border-top: none;
    border-bottom: 3px solid var(--color-outlines-dark);
  }

  .content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
  }

  /* title */
  .title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    line-height: 1.2;
    color: var(--color-text-dark);
  }

  /* meta info */
  .issuer,
  .date {
    font-size: 0.9rem;
    font-family: var(--font-body);
    color: var(--color-text-dark);
  }

  /* button */
  .button {
    margin-top: 1rem;
    background-color: transparent;
    color: var(--accent);
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85rem;
    border: 2px solid var(--accent);
    display: inline-block;
    border-radius: 0;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .button:hover {
    background-color: var(--accent);
    color: #fff;
  }

  /* no-link state */
  .no-link {
    font-style: italic;
    color: #666;
    font-size: 0.85rem;
  }

  /* arrow in button */
  .button .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
    margin-left: 0.25em;
  }
  .button:hover .arrow {
    transform: translateX(4px);
  }
</style>
