---
// CertificationItem.astro
export interface Props {
  title: string;
  issuer: string;
  date: string;
  link?: string;
}

const { title, issuer, date, link } = Astro.props;
---

<li class="certification-item">
  <div class="content">
    <h3 class="title">{title}</h3>
      <p class="issuer">Issued by <strong>{issuer}</strong></p>
  </div>
      <p class="date">Expires on: {date}</p>

      {
        link ? (
          <a
            href={link}
            class="button"
            target="_blank"
            rel="noopener noreferrer"
          >
            View Certificate{" "}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        ) : (
          <p class="no-link">No link available</p>
        )
      }
</li>

<style>

.certification-item { display:grid; grid-template-columns:minmax(0,1fr) 13rem auto; align-items:center; gap:1.5rem; padding:1.25rem 0; margin:0; border-bottom:1px solid var(--color-outlines); }
.content { min-width:0; }
.title { font-size:1rem; line-height:1.4; margin:0 0 .35rem; }
.issuer,.date,.no-link { font-size:.8rem; color:var(--color-muted); margin:0; }
.button { display:inline-flex; align-items:center; gap:.35rem; min-height:44px; padding:.5rem 0; font-size:.8rem; font-weight:600; white-space:nowrap; }
@media(max-width:800px) { .certification-item { grid-template-columns:minmax(0,1fr) auto; gap:.5rem 1rem; } .content { grid-column:1 / -1; } }
@media(max-width:400px) { .certification-item { grid-template-columns:1fr; } .button { justify-self:start; } }

</style>
