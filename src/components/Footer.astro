<div id="cookie-banner" class="cookie-banner">
  <div>
    This site uses cookies to measure traffic with Google Analytics 4. Link to
    Google's privacy policy: <a href="https://policies.google.com/privacy"
      >https://policies.google.com/privacy</a
    >.
    <div style="padding-top: 0.5rem;">
      <button id="accept-cookies" class="cookie-button">Accept</button>
      <button id="reject-cookies" class="cookie-button cancel">Reject</button>
    </div>
  </div>
</div>

<style>
  /* size knobs */
  :root {
    --footer-pad-desktop: 128px; /* was 48 */
    --footer-pad-mobile: 72px; /* was 40 */
    --footer-min-h: 320px; /* ensure tall bar */
  }

  footer {
    background: var(--accent);
    color: var(--color-text);
    border-top: 6px solid var(--color-outlines-dark);
    margin-top: 64px;

    /* keep the color full-bleed, then constrain content inside */
  }
  footer .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--footer-pad-desktop) 24px;
    padding-bottom: calc(
      var(--footer-pad-desktop) + env(safe-area-inset-bottom)
    ); /* iOS safe area */
    min-height: var(--footer-min-h);
    display: grid;
    place-items: center;
    gap: 1.25rem;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 1.25em;
  }

  .social-links a {
    color: #fff;
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }
  .social-links a:hover {
    transform: translateY(-2px);
    color: var(--color-text);
  }

  .social-links svg {
    width: 32px;
    height: 32px;
    display: block;
    fill: currentColor;
  }

  @media (max-width: 980px) {
    footer .inner {
      padding: var(--footer-pad-mobile) 16px;
      padding-bottom: calc(
        var(--footer-pad-mobile) + env(safe-area-inset-bottom)
      );
    }
  }

  .inner p {
    margin: 0;
  }

  .inner a:hover {
    text-decoration: underline;
  }

  .legal-links {
    margin-top: 0.5rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
    font-size: 0.85rem;
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const banner = document.getElementById("cookie-banner");
    const accept = document.getElementById("accept-cookies");
    const reject = document.getElementById("reject-cookies");

    // Initialize dataLayer
    window.dataLayer = window.dataLayer || [];

    // Define gtag function
    window.gtag = function gtag() {
      dataLayer.push(arguments);
    };

    // Aina sivulatauksessa – jos suostumus on annettu aiemmin, päivitä consent
    if (localStorage.getItem("cookiesAccepted") === "true") {
      window.gtag("consent", "update", {
        ad_storage: "granted",
        analytics_storage: "granted",
        ad_user_data: "granted",
        ad_personalization: "granted",
      });
    }

    if (banner && localStorage.getItem("cookiesAccepted")) {
      banner.style.display = "none";
    }

    if (
      banner &&
      accept &&
      reject &&
      !localStorage.getItem("cookiesAccepted")
    ) {
      banner.style.display = "block";

      accept.addEventListener("click", () => {
        window.gtag("consent", "update", {
          ad_storage: "granted",
          analytics_storage: "granted",
          ad_user_data: "granted",
          ad_personalization: "granted",
        });
        localStorage.setItem("cookiesAccepted", "true");
        banner.style.display = "none";
      });

      reject.addEventListener("click", () => {
        // Ei muuta consenteja, mutta voi halutessa estää uudelleen esiin tulemisen:
        localStorage.setItem("cookiesAccepted", "false");
        banner.style.display = "none";
      });
    }
  });

  function changeConsent() {
    const banner = document.getElementById("cookie-banner");
    const accept = document.getElementById("accept-cookies");
    const reject = document.getElementById("reject-cookies");
    if (banner && accept && reject) {
      banner.style.display = "block";

      accept.addEventListener("click", () => {
        window.gtag("consent", "update", {
          ad_storage: "granted",
          analytics_storage: "granted",
          ad_user_data: "granted",
          ad_personalization: "granted",
        });
        localStorage.setItem("cookiesAccepted", "true");
        banner.style.display = "none";
      });

      reject.addEventListener("click", () => {
        // Ei muuta consenteja, mutta voi halutessa estää uudelleen esiin tulemisen:
        localStorage.setItem("cookiesAccepted", "false");
        banner.style.display = "none";
      });
    }
  }
</script>
