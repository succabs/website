---
import FormattedDate from "./FormattedDate.astro";
import { Image } from "astro:assets";

export interface Props {
  title: string;
  date: Date;
  href: string;
  excerpt?: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
}

const { title, date, href, excerpt, heroImage, heroImageAlt } =
  Astro.props as Props;
---

<article class="blog-card">
  {
    heroImage && (
      <a href={`${href.endsWith("/") ? href : href + "/"}`} class="image">
        <Image
          src={heroImage}
          alt={heroImageAlt ?? title}
          width={420}
          height={236}
        />
      </a>
    )
  }
  <div class="content">
    <h3 class="title">
      <a href={`${href.endsWith("/") ? href : href + "/"}`}>{title}</a>
    </h3>
    {excerpt && <p class="excerpt">{excerpt}</p>}
    <p class="date"><FormattedDate date={date} /></p>
  </div>
</article>

<style>
  .blog-card {
    border: 3px solid #111; /* heavier, arcade-style outline */
    background: var(--accent-paper); /* cream/paper tone for contrast */
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition:
      transform 0.15s ease,
      background 0.15s ease;
    color: var(--color-outlines);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    background: var(--accent); /* red hover (Akira punch) */
    color: #fff; /* invert text */
  }

  .image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 1rem;
    border: 2px solid #111; /* framed like a poster */
  }

  .title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    text-transform: uppercase; /* poster feel */
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .blog-card .title a {
    color: var(--color-outlines); /* matches your card text */
  }

  .blog-card:hover .title a {
    color: inherit; /* flips with hover state */
  }

  .title a:hover {
    text-decoration: underline; /* more visible than subtle color shift */
  }

  .excerpt {
    flex-grow: 1;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .date {
    font-size: 0.8rem;
    font-weight: 600;
    margin-top: 1rem;
    color: #444;
  }
</style>
