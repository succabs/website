---
import FormattedDate from "./FormattedDate.astro";
import { Image } from "astro:assets";

export interface Props {
  title: string;
  date: Date;
  href: string;
  excerpt?: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
}

const { title, date, href, excerpt, heroImage, heroImageAlt } =
  Astro.props as Props;
---

<a href={`${href.endsWith("/") ? href : href + "/"}`} class="blog-card">
  {
    heroImage && (
      <Image
        class="image"
        src={heroImage}
        alt={heroImageAlt ?? title}
        width={420}
        height={236}
      />
    )
  }
  <div class="content">
    <h3 class="title">
      <span>{title}</span>
    </h3>
    {excerpt && <p class="excerpt">{excerpt}</p>}
    <p class="date"><FormattedDate date={date} /></p>
  </div>
</a>

<style>
  .blog-card {
    border: 3px solid var(--color-outlines-dark); /* heavier, arcade-style outline */
    background: var(--accent-second); /* cream/paper tone for contrast */
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition:
      transform 0.15s ease,
      background 0.15s ease;
    color: var(--color-text-dark);
    text-decoration: none;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    background: var(--accent); /* red hover (Akira punch) */
    color: var(--color-text);
    text-decoration-color: var(--color-text);
  }

  a img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 1rem;
    border: 2px solid var(--color-outlines-dark); /* framed like a poster */
  }

  .title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    text-transform: uppercase; /* poster feel */
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .blog-card .title {
    color: var(--color-text-dark); /* matches your card text */
    text-decoration: underline;
    text-decoration-color: var(--color-text-dark);
  }

  .blog-card:hover .title {
    color: inherit; /* flips with hover state */
    text-decoration-color: var(--color-text);
  }

  .title:hover {
    text-decoration: underline; /* more visible than subtle color shift */
    text-decoration-color: var(--color-text);
  }

  .excerpt {
    flex-grow: 1;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .date {
    font-size: 0.8rem;
    font-weight: 600;
    margin-top: 1rem;
    color: var(--color-text-dark);
  }

  .blog-card:hover .date {
    color: var(--color-text);
  }
</style>
