---
interface Props {
  title: string;
  place: string;
  timeframe: string;
  tech?: string[];
  tools?: string[];
}
const { title, place, timeframe, tech = [], tools = [] } = Astro.props;
---

<div class="experience-item">
  <p class="timeframe">{timeframe}</p>
  <div class="experience-details">
  <h3>{title}</h3>
  <p class="place">{place}</p>
  <slot />
  {
    tech.length > 0 && (
      <div class="tags">
        <strong>Tech stack:</strong>
        <div class="tag-list">
          {tech.map((item) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      </div>
    )
  }
  {
    tools.length > 0 && (
      <div class="tags">
        <strong>Tools:</strong>
        <div class="tag-list">
          {tools.map((item) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      </div>
    )
  }
  </div>
</div>

<style>

.experience-item { display:grid; grid-template-columns:12rem minmax(0,1fr); gap:2.5rem; padding:2rem 0; border-top:1px solid var(--color-outlines); }
.experience-item:first-of-type { margin-top:2rem; }
.timeframe { margin:0; padding-top:.2rem; color:var(--color-muted); font-size:.85rem; }
.experience-details { min-width:0; }
.experience-item h3 { font-size:1.35rem; margin:0 0 .5rem; }
.place { color:var(--accent); font-size:1rem; font-weight:500; margin:0 0 1.25rem; }
.tags { margin-top:1rem; font-size:.85rem; }
@media(max-width:700px) { .experience-item { grid-template-columns:1fr; gap:.75rem; padding:1.5rem 0; } }

</style>
