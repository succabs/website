---
interface Props {
  title: string;
  place: string;
  timeframe: string;
  tech?: string[];
  tools?: string[];
}
const { title, place, timeframe, tech = [], tools = [] } = Astro.props;
---

<section class="experience-item work">
  <!-- or study -->
  <h3>{title}</h3>
  <h4>@{place}</h4>
  {
    timeframe && (
      <p>
        <strong>{timeframe}</strong>
      </p>
    )
  }
  <slot />
  {
    tech.length > 0 && (
      <div class="tags">
        <strong>Tech stack:</strong>
        <div class="tag-list">
          {tech.map((item) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      </div>
    )
  }
  {
    tools.length > 0 && (
      <div class="tags">
        <strong>Tools:</strong>
        <div class="tag-list">
          {tools.map((item) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      </div>
    )
  }
</section>

<style>
  .experience-item {
    position: relative;
    background: var(--accent-paper);
    color: var(--color-outlines);
    border: 3px solid #111;
    border-radius: 0;
    padding: 1.5rem 1.5rem 1.25rem;
    margin-block: 2.25rem;
    box-shadow: none;
    transition: transform 0.12s ease;
  }
  .experience-item:hover {
    transform: translateY(-3px);
  }

  /* top spine bar */
  .experience-item::before {
    content: "";
    position: absolute;
    left: -3px;
    right: -3px;
    top: -3px;
    height: 10px;
    background: #111; /* default if no modifier */
  }
  .experience-item.work::before {
    background: var(--accent);
  } /* red */
  .experience-item.study::before {
    background: var(--color-outlines);
  } /* indigo */

  /* headings */
  .experience-item h3 {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.35rem;
    line-height: 1.1;
    margin: 0.25rem 0 0.35rem;
    color: #111; /* anchor the title */
  }
  .experience-item h4 {
    color: var(--font-outlines);
    font-size: 0.95rem;
    font-weight: 400;
    font-style: italic;
    margin: 0 0 0.4rem;
    opacity: 0.95;
  }

  /* timeframe */
  .experience-item p {
    margin: 0 0 0.6rem;
  }
  .experience-item p strong {
    color: #111;
  }

  /* list */
  .experience-item ul {
    margin: 0.6rem 0 0.2rem;
    padding-left: 1.1rem;
  }
  .experience-item li {
    margin: 0.28rem 0;
  }

  /* mobile */
  @media (max-width: 980px) {
    .experience-item {
      padding: 1.25rem;
    }
    .experience-item h3 {
      font-size: 1.2rem;
    }
  }
</style>
