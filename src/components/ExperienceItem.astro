---
interface Props {
  title: string;
  place: string;
  timeframe: string;
  tech?: string[];
  tools?: string[];
}
const { title, place, timeframe, tech = [], tools = [] } = Astro.props;
---

<section class="experience-item work">
  <!-- or study -->
  <h3>{title}</h3>
  <h4>@{place}</h4>
  {
    timeframe && (
      <p>
        <strong>{timeframe}</strong>
      </p>
    )
  }
  <slot />
  {
    tech.length > 0 && (
      <div class="tags">
        <strong>Tech stack:</strong>
        <div class="tag-list">
          {tech.map((item) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      </div>
    )
  }
  {
    tools.length > 0 && (
      <div class="tags">
        <strong>Tools:</strong>
        <div class="tag-list">
          {tools.map((item) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      </div>
    )
  }
</section>

<style>

.experience-item { background:var(--accent-second); color:var(--color-text); border:1px solid var(--color-outlines); border-left:3px solid var(--accent); padding:2rem; margin:2rem 0; }
.experience-item h3 { font-size:1.35rem; margin:0 0 .5rem; }
.experience-item h4 { font-size:1rem; font-weight:500; margin:0 0 .75rem; }
.experience-item p { margin:0 0 .75rem; }
.tags { margin-top:1rem; font-size:.85rem; }
@media(max-width:700px) { .experience-item { padding:1.25rem; } }

</style>
