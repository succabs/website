---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";
import ScrollTopButton from "../components/ScrollTopButton.astro";
import "@fontsource/anton";
import "@fontsource/inter";
import AuthorCard from "../components/AuthorCard.astro";
import type { MarkdownHeading } from "@astrojs/markdown-remark";

type Props = CollectionEntry<"blog">["data"] & {
  readTime: number;
  tags?: string[];
  headings?: MarkdownHeading[];
  keywords?: string[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  readTime,
  tags = [],
  headings = [],
  keywords = [],
} = Astro.props as Props;

const tocHeadings = headings.filter(({ depth }) => depth > 1 && depth < 4);

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? "https://arttu.net");

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate?.toISOString(),
  url: pageUrl.toString(),
  image: heroImage
    ? {
        "@type": "ImageObject",
        url: (Astro.site?.origin ?? "https://arttu.net") + heroImage.src,
        width: heroImage.width,
        height: heroImage.height,
      }
    : undefined,
  author: {
    "@type": "Person",
    name: "Arttu Nikkilä",
    url: "https://arttu.net",
    sameAs: [
      "https://github.com/succabs",
      "https://linkedin.com/in/arttu-nikkila",
      "https://arttu.net",
    ],
  },
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body
    data-last-update-time={updatedDate
      ? new Date(updatedDate).toISOString()
      : pubDate.toISOString()}
  >
    <Header />
    <main class="content">
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt={heroImageAlt ?? title}
              />
            )
          }
        </div>

        <div class="article-card">
          <header class="article-header">
            <h1>{title}</h1>

            {
              tags.length > 0 && (
                <div class="tag-list">
                  {tags.map((t) => (
                    <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>
                      {t}
                    </a>
                  ))}
                </div>
              )
            }
            <div class="meta">
              Published on: <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <span class="last-updated-on">
                    {" "}
                    — updated <FormattedDate date={updatedDate} />
                  </span>
                )
              }
              <span class="read-time">🕒 {readTime} min read</span>
            </div>
          </header>

          <hr class="hr-3" />

          <div class="article-body-with-toc">
            {
              tocHeadings.length > 0 && (
                <aside class="toc-card" aria-label="Table of contents">
                  <h2 class="toc-title">Table of Contents</h2>
                  <ul class="toc-list">
                    {tocHeadings.map((heading) => (
                      <li class={`toc-item depth-${heading.depth}`}>
                        <a href={`#${heading.slug}`}>{heading.text}</a>
                      </li>
                    ))}
                  </ul>
                </aside>
              )
            }
            <div class="article-body">
              <slot />

              {
                keywords.length > 0 && (
                  <div class="keyword-list">
                    <span>keywords for the article: </span>
                    <span class="keyword">{keywords.join(", ")}</span>
                  </div>
                )
              }
            </div>
          </div>

          <AuthorCard />

          <div class="back-to-index">
            <a href="/blog/">← Back to blog index</a>
          </div>
        </div>
      </article>
    </main>
    <Footer />
    <ScrollTopButton />
  </body><script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <style>
    @media (max-width: 980px) {
      body {
        font-size: 16px;
      }
      main {
        padding: 0 16px;
      }
    }
  </style>
</html>
