---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { Image } from "astro:assets";
import ScrollTopButton from "../../components/ScrollTopButton.astro";
import "@fontsource/anton";
import "@fontsource/inter";

export async function getStaticPaths() {
  const wordsPerMinute = 200;
  const posts = await getCollection("blog");
  const allTags = Array.from(
    new Set(posts.flatMap((post) => post.data.tags ?? []))
  );
  return allTags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((post) => (post.data.tags ?? []).includes(tag))
        .map((post) => {
          const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
          const readTime = Math.max(1, Math.round(wordCount / wordsPerMinute));
          return {
            ...post,
            data: {
              ...post.data,
              readTime,
            },
          };
        }),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Blog"
      description="Posts tagged with {tag} on the blog of Arttu Nikkilä."
    />
    <style>
      /* container */
      .back-to-index a {
        background-color: var(--accent-second);
      }
      .back-to-index a:hover {
        background-color: var(--accent);
        color: var(--color-text);
      }
      main {
        max-width: var(--max-width);
        margin-inline: auto;
        padding-inline: 64px;
        margin-block: 64px;
      }
      @media (max-width: 980px) {
        main {
          padding-inline: 16px;
        }
      }

      /* description under page title */
      .page-description {
        margin: 0 0 1.25rem;
      }

      /* ===== toolbar (sticky) ===== */
      .controls-bar {
        position: sticky;
        top: 60px; /* adjust if your header is taller */
        z-index: 10;
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        padding: 0.6rem 0.8rem;
        background: rgba(
          37,
          117,
          185,
          0.85
        ); /* blue with slight translucency */
        backdrop-filter: blur(6px);
        border: 3px solid var(--color-outlines-dark);
        margin: 1rem 0;
      }

      .controls-label {
        font-family: var(--font-heading);
        text-transform: uppercase;
        margin-right: 0.5rem;
      }

      /* filter chips */
      .filter-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        align-items: center;
      }
      .filter-btn {
        font-family: var(--font-heading);
        text-transform: uppercase;
        font-size: 1rem;
        padding: 0.25em 0.6em;
        border: 2px solid var(--color-headings); /* cream outline on blue */
        background: transparent;
        color: var(--color-headings);
        cursor: pointer;
      }
      .filter-btn:hover {
        transform: translateY(-1px);
      }
      .filter-btn.active {
        background: var(--accent);
        border-color: var(--color-outlines);
        color: #fff;
      }

      /* sort select */
      .sort-control {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .sort-select {
        font-family: var(--font-heading);
        text-transform: uppercase;
        font-size: 1rem;
        padding: 0.25em 0.6em;
        border: 2px solid var(--color-headings);
        background: transparent;
        color: var(--color-headings);
      }

      .sort-select,
      .filter-btn,
      .controls-bar {
        letter-spacing: 0.03em;
      }

      @media (min-width: 600px) {
        .sort-select,
        .filter-btn,
        .controls-bar {
          letter-spacing: 0.08em;
        }
      }

      /* ===== post list ===== */
      .posts-list {
        display: grid;
        gap: 2rem;
        margin-top: 1.5rem;
      }

      /* card */
      .post-item {
        position: relative;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1.25rem;
        align-items: flex-start;

        background: var(--accent-second);
        color: var(--color-text-dark);
        border: 3px solid var(--color-outlines-dark);
        padding: 2rem 1.25rem 2.1rem;
      }

      /* red spine */
      .post-item::before {
        content: "";
        position: absolute;
        left: -3px;
        right: -3px;
        top: -3px;
        height: 10px;
        background: var(--accent);
      }

      /* content */
      .post-content {
        max-width: 70ch;
      }
      .post-title {
        font-family: var(--font-heading);
        text-transform: uppercase;
        margin: 0.2rem 0 0.35rem;
        line-height: 1.1;
        font-size: clamp(1.25rem, 3vw, 1.6rem);
      }
      .post-title a {
        color: var(--color-text-dark);
        text-decoration: underline;
        text-decoration-color: var(--color-outlines-dark);
        text-underline-offset: 1px;
      }
      .post-title a:hover {
        text-decoration-color: var(--accent);
      }

      /* excerpt + meta */
      .post-excerpt {
        margin: 0.4rem 0 0.6rem;
        line-height: 1.6;
      }
      .post-date {
        font-size: 0.85rem;
        margin: 0.25rem 0 0.6rem;
      }

      /* CTA */
      .read-more {
        display: inline-block;
        text-transform: uppercase;
        font-weight: 800;
        font-size: 0.85rem;
        padding: 0.4rem 0.6rem;
        border: 2px solid var(--accent);
        color: var(--accent);
        background: transparent;
        text-decoration: none;
      }
      .read-more:hover {
        background: var(--accent);
        color: #fff;
      }

      /* thumbnail */
      .post-image {
        --thumb-w: 360px;
        width: var(--thumb-w);
      }
      .post-image img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16/10;
        object-fit: cover;
        border: 3px solid var(--color-outlines-dark);
      }

      /* pagination */
      .pagination {
        margin-top: 2rem;
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
      }
      .page-btn {
        font-family: var(--font-heading);
        font-size: 0.8rem;
        padding: 0.35em 0.6em;
        border: 2px solid var(--color-outlines-dark);
        background: transparent;
        color: var(--color-text-dark);
        cursor: pointer;
      }
      .page-btn.active {
        background: var(--accent);
        color: var(--color-text);
        border-color: var(--color-outlines);
      }
      .page-btn[disabled] {
        opacity: 0.4;
        cursor: default;
      }
      .arrow-btn {
        font-weight: 800;
      }

      /* mobile */
      @media (max-width: 980px) {
        .controls-bar {
          position: static;
          padding: 0.5rem 0.6rem;
          flex-direction: column;
          align-items: flex-start;
        }
        .post-item {
          grid-template-columns: 1fr;
          gap: 0.9rem;
          padding: 0.9rem 0.9rem 1rem;
        }
        .post-image {
          width: 100%;
        }
      }
    </style>
  </head>
</html>
<body class="page-blog">
  <Header />
  <main class="content">
    <h1>All posts tagged with: <strong>{tag}</strong></h1>
    <section class="posts-list">
      {
        posts.map((post) => (
          <article class="post-item">
            <div class="post-content">
              <h2 class="post-title">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              {post.data.excerpt && (
                <p class="post-excerpt">{post.data.excerpt}</p>
              )}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="tag-list">
                  {post.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              )}
              <p class="post-date">
                <FormattedDate date={post.data.pubDate} />
                <span class="read-time"> 🕒 {post.data.readTime} min read</span>
              </p>
              <a href={`/blog/${post.id}/`} class="read-more">
                Read The Post →
              </a>
            </div>
            {post.data.heroImage && (
              <div class="post-image">
                <Image
                  width={800}
                  height={450}
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt ?? post.data.title}
                />
              </div>
            )}
          </article>
        ))
      }
      <div class="back-to-index">
        <a href="/blog/">← Back to blog index</a>
      </div>
    </section>
  </main>
  <Footer />
  <ScrollTopButton />
</body><script is:inline>
  const banner = document.getElementById("cookie-banner");
  const accept = document.getElementById("accept-cookies");
  const reject = document.getElementById("reject-cookies");

  // Initialize dataLayer
  window.dataLayer = window.dataLayer || [];

  // Define gtag function
  function gtag() {
    dataLayer.push(arguments);
  }

  // Aina sivulatauksessa – jos suostumus on annettu aiemmin, päivitä consent
  if (localStorage.getItem("cookiesAccepted") === "true") {
    window.gtag("consent", "update", {
      ad_storage: "granted",
      analytics_storage: "granted",
      ad_user_data: "granted",
      ad_personalization: "granted",
    });
  }

  if (banner && localStorage.getItem("cookiesAccepted")) {
    banner.style.display = "none";
  }

  if (banner && accept && reject && !localStorage.getItem("cookiesAccepted")) {
    banner.style.display = "block";

    accept.addEventListener("click", () => {
      window.gtag("consent", "update", {
        ad_storage: "granted",
        analytics_storage: "granted",
        ad_user_data: "granted",
        ad_personalization: "granted",
      });
      localStorage.setItem("cookiesAccepted", "true");
      banner.style.display = "none";
    });

    reject.addEventListener("click", () => {
      // Ei muuta consenteja, mutta voi halutessa estää uudelleen esiin tulemisen:
      localStorage.setItem("cookiesAccepted", "rejected");
      banner.style.display = "none";
    });
  }
</script>
