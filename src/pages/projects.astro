---
import Layout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";

const liveProjects = await getCollection("projects");

const grouped = new Map<
  string,
  { entries: CollectionEntry<"projects">[]; order: number }
>();
for (const entry of liveProjects) {
  const bucket = grouped.get(entry.data.category) ?? {
    entries: [],
    order: entry.data.chapterIndex ?? Number.POSITIVE_INFINITY,
  };
  bucket.entries.push(entry);
  bucket.order = Math.min(
    bucket.order,
    entry.data.chapterIndex ?? Number.POSITIVE_INFINITY
  );
  grouped.set(entry.data.category, bucket);
}

const chapters = Array.from(grouped.entries())
  .sort((a, b) => a[1].order - b[1].order || a[0].localeCompare(b[0]))
  .map(([category, info], index) => ({
    number: index + 1,
    category,
    entries: info.entries.sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime()
    ),
  }));

const paragraphs = (text?: string) =>
  text
    ?.split(/\n+/)
    .map((line) => line.trim())
    .filter(Boolean) ?? [];

const getCtas = (links?: {
  demo?: string;
  code?: string;
  caseStudy?: string;
}) =>
  Object.entries({
    demo: links?.demo,
    code: links?.code,
    caseStudy: links?.caseStudy,
  }).filter(([, value]) => Boolean(value));

const siteOrigin = Astro.site?.origin ?? "";
const jsonLdProjects = liveProjects.map((entry) => ({
  "@context": "https://schema.org",
  "@type": entry.data.links?.code ? "SoftwareSourceCode" : "CreativeWork",
  name: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString(),
  url: `${siteOrigin}/projects#${entry.data.id}`,
  keywords: entry.data.tags.join(", "),
  ...(entry.data.links?.code ? { codeRepository: entry.data.links.code } : {}),
  ...(entry.data.links?.demo ? { discussionUrl: entry.data.links.demo } : {}),
}));

const lastmod = "2025-11-22T00:00:00Z";
---

<Layout
  title="Projects"
  description="Tools, games, helpers, and experiments by Arttu Nikkilä."
  pageClass="projects-page"
  lastmod={lastmod}
>
  <section class="projects-hero" aria-labelledby="projects-hero-title">
    <div class="hero-inner">
      <div class="hero-copy">

        <h1 id="projects-hero-title">Projects</h1>
        <p class="hero-intro">
          A single-scroll showcase of tools, games, helpers, and experiments.
          Some were built to make daily work easier, others just for fun, and a
          few landed somewhere in between. They've all earned a spot here
          because they solved a problem, taught me something, or simply made me
          laugh while building them.
        </p>
      </div>

    </div>
  </section>

  <section class="projects-main" aria-label="Project anthology">
    {
      chapters.map((chapter) => (
        <section
          class="projects-chapter"
          aria-labelledby={`chapter-${chapter.number}`}
        >
          <header class="chapter-header" id={`chapter-${chapter.number}`}>
            <p class="chapter-label">0{chapter.number}</p>
            <h2>{chapter.category}</h2>
          </header>
          <div class="chapter-spreads">
            {chapter.entries.map((entry) => {
              const { data } = entry;
              const ctas = getCtas(data.links);
              const primaryImage = data.images[0];
              return (
                <article
                  id={data.id}
                  class="project-spread on-paper"
                  data-spread-id={data.id}
                  aria-labelledby={`${data.id}-title`}
                >
                  <div class="spread-page spread-page--left">
                    <header class="spread-header">
                      {data.sticker &&
                        !["selected", "new"].includes(
                          data.sticker.toLowerCase()
                        ) && (
                          <span
                            class={`spread-sticker spread-sticker-${data.sticker.toLowerCase()}`}
                          >
                            {data.sticker}
                          </span>
                        )}
                      <h3 id={`${data.id}-title`}>{data.title}</h3>
                      <p class="spread-summary">{data.summary}</p>
                    </header>
                    {primaryImage && (
                      <div class="spread-media">
                        <Image
                          class="spread-image"
                          src={primaryImage.src}
                          alt={primaryImage.alt}
                          loading="lazy"
                          decoding="async"
                          sizes="(min-width: 1080px) 40vw, (min-width: 720px) 60vw, 92vw"
                          widths={[480, 720, 960]}
                        />
                      </div>
                    )}
                    {data.funFact && (
                      <p class="spread-callout" role="note">
                        <span class="callout-prefix">Fun Fact</span>
                        <span>{data.funFact}</span>
                      </p>
                    )}
                  </div>
                  <div class="spread-page spread-page--right">
                    {data.description && (
                      <div class="spread-body">
                        {paragraphs(data.description).map((paragraph) => (
                          <p>{paragraph}</p>
                        ))}
                      </div>
                    )}
                    {(data.stack && data.stack.length > 0) ||
                    (data.outcomes && data.outcomes.length > 0) ? (
                      <div class="spread-meta" aria-label="Project details">
                        {data.stack && data.stack.length > 0 && (
                          <div class="spread-stack">
                            <h4>Tech stack</h4>
                            <div class="spread-tags" role="list">
                              {data.tags.map((tag) => (
                                <span class="spread-tag" role="listitem">
                                  {tag}
                                </span>
                              ))}
                            </div>
                          </div>
                        )}
                        {data.outcomes && data.outcomes.length > 0 && (
                          <ul class="spread-outcomes">
                            {data.outcomes.slice(0, 2).map((outcome) => (
                              <li>{outcome}</li>
                            ))}
                          </ul>
                        )}
                      </div>
                    ) : null}
                    <footer class="spread-footer">
                      {ctas.length > 0 ? (
                        <nav class="spread-ctas" aria-label="Project links">
                          {ctas.map(([key, url]) => (
                            <a
                              href={url}
                              target="_blank"
                              rel="noopener"
                              class={`spread-cta spread-cta-${key}`}
                            >
                              {key === "demo" && "Demo"}
                              {key === "code" && "code on github"}
                              {key === "caseStudy" && "Case Study"}
                            </a>
                          ))}
                        </nav>
                      ) : (
                        <span />
                      )}
                    </footer>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))
    }

    <a
      class="hero-link"
      href="https://github.com/succabs"
      target="_blank"
      rel="noopener"
    >
      More projects on GitHub
    </a>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLdProjects)}
  />
</Layout>



<style>

.projects-hero { margin-bottom:4rem; }
.projects-hero h1 { margin-bottom:1.5rem; }
.hero-intro { max-width:70ch; }
.projects-main,.chapter-spreads { display:grid; gap:3rem; }
.projects-chapter { margin-bottom:2rem; }
.chapter-header { display:flex; gap:1rem; align-items:baseline; padding-bottom:1rem; margin-bottom:2rem; border-bottom:1px solid var(--color-outlines); }
.chapter-label { color:var(--accent); font-size:.85rem; font-weight:600; margin:0; }
.chapter-header h2 { margin:0; font-size:1.5rem; }
.project-spread { display:grid; grid-template-columns:1fr 1fr; gap:3rem; padding:2rem; background:var(--accent-second); border:1px solid var(--color-outlines); width:100%; }
.spread-page { display:grid; align-content:start; gap:1.5rem; min-width:0; }
.spread-header h3 { font-size:1.7rem; }
.spread-summary { margin:.75rem 0 0; font-size:.95rem; color:var(--color-muted); }
.spread-image { display:block; width:100%; height:auto; }
.spread-media { border:1px solid var(--color-outlines); background:white; }
.spread-callout { margin:0; padding-left:1rem; border-left:2px solid var(--accent); font-size:.85rem; color:var(--color-muted); }
.callout-prefix { display:block; font-weight:600; color:var(--accent); margin-bottom:.35rem; }
.spread-body p { margin:0 0 1rem; font-size:.95rem; }
.spread-stack h4 { font-size:.8rem; margin-bottom:.75rem; }
.spread-tags { display:flex; flex-wrap:wrap; gap:.5rem; }
.spread-tag { font-size:.75rem; border:1px solid var(--color-outlines); padding:.3rem .5rem; }
.spread-outcomes { font-size:.9rem; padding-left:1.2rem; margin:1.5rem 0 0; }
.spread-outcomes li { margin-bottom:.5rem; }
.spread-ctas { display:flex; flex-wrap:wrap; gap:1rem; }
.spread-cta,.hero-link { display:inline-flex; padding:.7rem 1.1rem; border:1px solid var(--color-outlines-dark); color:var(--color-bg); background:var(--color-outlines-dark); font-size:.85rem; font-weight:600; text-decoration:none; justify-content:center; }
.spread-cta:hover,.hero-link:hover { background:var(--accent); border-color:var(--accent); }
.hero-link { justify-self:start; }
.spread-sticker { font-size:.75rem; color:var(--accent); }
@media(max-width:850px) { .project-spread { grid-template-columns:1fr; padding:1.25rem; gap:2rem; } }

</style>
