---
import Layout from "../layouts/BaseLayout.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import CertificationItem from "../components/CertificationItem.astro";
import { Icon } from "astro-icon/components";

const certifications = [
  {
    title: "Liquid Storefronts for Theme Developers",
    issuer: "Shopify",
    date: " December 30, 2026",
    link: "https://www.credly.com/badges/c1d148e9-208e-410f-a09a-f58535c5855b",
  },
  {
    title: "Solution Planning Fundamentals",
    issuer: "Shopify",
    date: "December 29, 2026",
    link: "https://www.credly.com/badges/c1d148e9-208e-410f-a09a-f58535c5855b",
  },
  {
    title: "Marketing Fundamentals",
    issuer: "Shopify",
    date: " December 29, 2026",
    link: "https://www.credly.com/badges/c1d148e9-208e-410f-a09a-f58535c5855b",
  },
  {
    title: "Google Analytics Certification",
    issuer: "Skillshop",
    date: "August 26, 2026",
    link: "https://skillshop.credential.net/e2cfdcba-1898-4ffb-918d-baea0ccc8916",
  },
  {
    title: "Channable Feed Management",
    issuer: "Channable",
    date: "August 22, 2026",
    link: "https://www.credential.net/2a263c35-11c0-442b-b97f-ccb696729331#gs.e5zz7z",
  },
  {
    title: "Channable Marketplaces",
    issuer: "Channable",
    date: "August 22, 2026",
    link: "https://www.credential.net/ffda8096-9cea-44c6-8f1a-52e93ba71c07#acc.3YLo9yEx",
  },
];
---

<Layout
  title="Experience"
  description="Work, education, certifications, and skills: all the relevant IT experience I've built so far."
  pageClass="page-red"
>
  <h1>Experience</h1>

  <p class="full-width">
    <a href="#work">Work</a>, <a href="#education">education</a>, <a
      href="#certifications">certifications</a
    >, and <a href="#skills">skills</a>: all the relevant IT experience I've
    built so far.
  </p>

  <hr class="hr-4" />

  <section id="work">
    <h2>Work</h2>

    <ExperienceItem
      title="Developer"
      place="Woolman"
      timeframe="March 2024 – Present"
      tech={["Liquid", "HTML", "CSS", "JS", "React", "GraphQL", "REST"]}
      tools={[
        "GTM",
        "GA4",
        "Channable",
        "Matrixify",
        "Excel",
        "Shopify",
        "Git",
        "Teams",
        "Slack",
        "Jira",
        "Teamwork",
        "ChatGPT",
        "Cursor",
        "Copilot",
      ]}
    >
      <ul>
        <li>
          Built custom Shopify themes with Liquid, HTML, CSS, JS, and React.
        </li>
        <li>
          Implemented and fixed analytics setups using GTM, GA4, Piwik, Custom
          Pixels and various CMPs.
        </li>
        <li>
          Worked on both solo builds and larger enterprise-grade team projects.
        </li>
        <li>
          Integrated REST and GraphQL APIs for store features and 3rd-party
          tools.
        </li>
        <li>
          Planned the best solutions considering customer's needs for their
          specific industry.
        </li>
        <li>
          Used AI-tools including ChatGPT, Cursor, and CoPilot to improve daily
          workflow.
        </li>
      </ul>
    </ExperienceItem>

    <ExperienceItem
      title="Junior Developer"
      place="Woolman"
      timeframe="September 2023 – March 2024"
      tech={["Liquid", "HTML", "CSS", "JS", "REST"]}
      tools={["Git", "Teams", "Slack", "Jira", "Teamwork", "ChatGPT"]}
    >
      <ul>
        <li>Joined after B.Sc. graduation.</li>
        <li>
          Went straight to the deep end and started hands-on with Liquid, JS,
          HTML, and CSS from day one.
        </li>
        <li>Worked on both projects and support tasks.</li>
        <li>
          Learned the Shopify ecosystem and agency workflows under solid
          mentorship.
        </li>
        <li>Moved from junior to core contributor in under 6 months.</li>
      </ul>
    </ExperienceItem>
  </section>

  <hr class="hr-3" />

  <section id="education">
    <h2>Education</h2>

    <ExperienceItem
      title="Master's Degree in Educational Technology"
      place="University of Jyväskylä"
      timeframe="September 2025 - Present"
    >
      <ul>
        <li>
          Studying towards becoming a Technical Specialist in Educational
          Technology alongside full-time work.
        </li>
      </ul>
    </ExperienceItem>

    <ExperienceItem
      title="B.Sc. in Mathematical Information Technology"
      place="University of Jyväskylä"
      timeframe="September 2016 - June 2023"
    >
      <ul>
        <li><strong>Major:</strong> Computer Science</li>
        <li><strong>Minor:</strong> Psychology</li>
        <li>
          <strong>Thesis:</strong>
          <a
            href="https://jyx.jyu.fi/handle/123456789/81727"
            target="_blank"
            rel="noopener noreferrer">Esoteric Programming Languages</a
          >
        </li>
      </ul>
    </ExperienceItem>
  </section>

  <hr class="hr-3" />

  <section id="certifications">
    <h2>Certifications</h2>

    <div class="certifications-grid">
      {
        certifications.map((cert) => (
          <CertificationItem
            title={cert.title}
            issuer={cert.issuer}
            date={cert.date}
            link={cert.link}
          />
        ))
      }
    </div>
  </section>

  <hr class="hr-3" />

  <section id="skills">
    <h2>Skills</h2>

    <h3 class="normal">Frontend</h3>
    <div class="tag-list">
      <span class="tag blue"><Icon name="logos:html-5" /> HTML5</span>
      <span class="tag blue"><Icon name="logos:css-3" />CSS3</span>
      <span class="tag blue"><Icon name="logos:javascript" />JavaScript</span>
      <span class="tag blue"><Icon name="devicon:typescript" />TypeScript</span>
      <span class="tag blue"
        ><Icon name="vscode-icons:file-type-liquid" />Liquid</span
      >
      <span class="tag blue"><Icon name="logos:react" />React</span>
      <span class="tag blue"><Icon name="devicon:astro" />Astro</span>
      <span class="tag blue"><Icon name="devicon:jquery" />jQuery</span>
      <span class="tag blue"
        ><Icon name="devicon:tailwindcss" />TailwindCSS</span
      >
      <span class="tag blue"><Icon name="logos:bootstrap" />Bootstrap</span>
      <span class="tag blue"><Icon name="devicon:vite" />Vite</span>
    </div>

    <h3 class="normal">Backend</h3>
    <div class="tag-list">
      <span class="tag red"><Icon name="devicon:python" />Python</span>
      <span class="tag red"><Icon name="devicon:flask" />Flask</span>
      <span class="tag red"><Icon name="devicon:nodejs" />Node.js</span>
      <span class="tag red"><Icon name="devicon:mysql" />SQL</span>
      <span class="tag red"><Icon name="logos:nginx" />Nginx</span>
    </div>

    <h3 class="normal">Tools & DevOps</h3>
    <div class="tag-list">
      <span class="tag blue"><Icon name="devicon:git" />Git</span>
      <span class="tag blue"><Icon name="devicon:vscode" />VSCode</span>
      <span class="tag blue"><Icon name="devicon:docker" />Docker</span>
      <span class="tag blue"><Icon name="devicon:linux" />Linux</span>
      <span class="tag blue"><Icon name="devicon:azure" />Azure DevOps</span>
      <span class="tag blue"><Icon name="devicon:jira" />Jira</span>
      <span class="tag blue"><Icon name="logos:teamwork-icon" />Teamwork</span>
      <span class="tag blue"
        ><Icon name="logos:microsoft-teams" />Microsoft Teams</span
      >
      <span class="tag blue"><Icon name="logos:shopify" />Shopify</span>
    </div>

    <h3 class="normal">Analytics & Marketing Tech</h3>
    <div class="tag-list">
      <span class="tag red"
        ><Icon name="logos:google-analytics" />Google Analytics</span
      >
      <span class="tag red"
        ><Icon name="logos:google-tag-manager" />Google Tag Manager</span
      >
      <span class="tag red">🍪 Consent Management</span>
      <span class="tag red">Channable</span>
    </div>
  </section>

  <style>
    /* =========================================
   EXPERIENCE PAGE — CLEAN STYLES
   ========================================= */

    /* Section spacing */
    section + section {
      margin-top: 3rem;
    }

    /* H3 spacing on this page (you already use Anton globally) */
    section h3 {
      margin: 2rem 0 1rem;
    }
    .normal {
      text-transform: none;
    }

    /* ===== Certifications grid (keeps your new CertificationItem) ===== */
    .certifications-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      margin-top: 2.25rem;
    }

    /* REMOVE: legacy card styles no longer used by CertificationItem
   .certification-card, .certification-title, .certification-meta, .certification-link
*/

    /* ===== Skills ===== */
    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 0.6rem;
      margin: 0 0 1rem;
    }

    .tag {
      /* poster chips */
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.22rem 0.6rem;
      font-size: 0.9rem;
      line-height: 1.2;
      border: 2px solid #111;
      border-radius: 0;
      background: transparent;
      background: var(--accent-paper); /* indigo */
      color: var(--color-outlines);
      transition:
        transform 0.08s ease,
        background 0.12s ease,
        color 0.12s ease,
        border-color 0.12s ease;
    }

    .tag svg {
      width: 1em;
      height: 1em;
    }

    /* Hover “fighter-select” feel */
    .tag:hover {
      transform: translateY(-2px);
    }

    /* Variants (you’re already outputting .blue / .red) */
    .tag.blue:hover {
      background: var(--accent); /* vermilion */
      color: var(--color-outlines);
    }
    .tag.red:hover {
      background: var(--accent); /* vermilion */
      color: var(--accent-paper);
    }

    /* Mobile tweaks */
    @media (max-width: 980px) {
      .tag {
        font-size: 0.88rem;
        padding: 0.2rem 0.55rem;
      }
    }
  </style>
</Layout>
