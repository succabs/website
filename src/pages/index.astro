---
// pages/index.astro
import Layout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION } from "../consts";
import "@fontsource/caveat";
import { Image } from "astro:assets";
import Me from "../assets/me.jpg";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "arttu.net",
  url: "https://arttu.net",
  author: {
    "@type": "Person",
    name: "Arttu Nikkilä",
    url: "https://arttu.net",
    sameAs: [
      "https://github.com/succabs",
      "https://linkedin.com/in/arttu-nikkila",
      "https://arttu.net",
    ],
  },
  description: SITE_DESCRIPTION,
};

const lastmod = "2025-11-13T00:00:00Z";
---

<style>

.intro { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:4rem; align-items:start; }
.intro h1 { margin-bottom:2rem; }
.intro-image { padding-top:5rem; }
.intro-image img { display:block; width:100%; aspect-ratio:1; object-fit:cover; border:1px solid var(--color-outlines-dark); }
.signature { font-family:Caveat,cursive; font-size:2rem; margin:2rem 0 1.5rem; }
.contact-links { display:flex; flex-wrap:wrap; gap:1.5rem; font-size:.9rem; font-weight:600; }
@media(max-width:800px) { .intro { grid-template-columns:1fr; gap:2.5rem; } .intro-image { padding:0; max-width:440px; } }

</style>
<Layout
  lastmod={lastmod}
  title="Home"
  description="Digital playground of an eCommerce Expert and Developer Arttu Nikkilä — experience, projects, skills and personal experiments in web development."
>
  <section class="intro">
    <div class="intro-text">
      <h1>Hello / Tervetuloa.</h1>
      <p>
        I'm <strong>Arttu Nikkilä</strong>. Nice to meet you.
      </p>
      <p>
        In my current role as a <strong>developer</strong> I adapt to a wide range
        of situations deeply in the <em>client interface</em>, balancing
        technical expertise with customer-facing responsibilities in the field
        of eCommerce. I'm based in <strong>Jyväskylä, Finland</strong>.
      </p>

      <p>
        Alongside work, I'm also studying towards a Master's Degree in
        Educational Technology at the University of Jyväskylä.
      </p>

      <p>
        Outside of work and studies, I spend my time on a mix of things: from
        running to{" "}
        reading and DJ'ing.
      </p>

      <p>
        That was my elevator pitch. This website, however, is my personal
        website which is both a display of my skills and a playground for me to
        test and play around different things related to web development. Feel
        free to check out my <a href="/projects/">projects</a> or read about my <a
          href="/experience/">experience</a
        >. Enjoy your stay!
      </p>
      <p>Och samma på finska och svenska.</p>
      <p class="signature">– Arttu :)</p>
      <nav class="contact-links" aria-label="Contact"><a href="mailto:artnikkila@gmail.com">Email ↗</a><a href="https://linkedin.com/in/arttu-nikkila" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://github.com/succabs" target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav>
    </div>

    <div class="intro-image">
      <Image src={Me} priority alt="portrait of Arttu Nikkilä" />
    </div>
  </section>

</Layout>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
