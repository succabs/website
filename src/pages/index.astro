---
// pages/index.astro
import Layout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION } from "../consts";
import { Image } from "astro:assets";
import Me from "../assets/me.jpg";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "arttu.net",
  url: "https://arttu.net",
  author: {
    "@type": "Person",
    name: "Arttu Nikkilä",
    url: "https://arttu.net",
    sameAs: [
      "https://github.com/succabs",
      "https://linkedin.com/in/arttu-nikkila",
      "https://arttu.net",
    ],
  },
  description: SITE_DESCRIPTION,
};

const lastmod = "2026-11-08T00:00:00Z";
---

<style>

.intro { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:4rem; align-items:start; }
.intro h1 { margin-bottom:2rem; }
.intro-image { padding-top:5rem; }
.intro-image img { display:block; width:100%; aspect-ratio:1; object-fit:cover; filter:brightness(.8); border:1px solid var(--color-outlines-dark); }
.signature { font-family:Caveat,cursive; font-size:2rem; margin:2rem 0 1.5rem; }
.contact-links { display:flex; flex-wrap:wrap; gap:1.5rem; font-size:.9rem; font-weight:600; }
@media(max-width:800px) { .intro { grid-template-columns:1fr; gap:2.5rem; } .intro-image { order:-1; padding:0; width:min(80%,300px); justify-self:center; } }

</style>
<Layout
  lastmod={lastmod}
  title="Home"
  description="Arttu Nikkilä, developer at Woolman in Jyväskylä, Finland. Custom Shopify storefronts, analytics and consent setups, and personal projects."
>
  <section class="intro">
    <div class="intro-text">
      <h1>Hello / Tervetuloa.</h1>
      <p>
        I'm <strong>Arttu Nikkilä</strong>, a developer
        based in Jyväskylä, Finland. In my current role I build custom Shopify
        storefronts and specialise in analytics and consent setups, making sure
        the tracking behind the store works as intended. I work directly with clients, translating business needs into working storefronts and reliable tracking.
      </p>


      <p>
        Alongside work, I'm also studying towards a Master's Degree in
        Educational Technology at the University of Jyväskylä.
      </p>

      <p>
        Outside of work and studies, I enjoy running, reading, DJ'ing, and
        playing Magic: The Gathering.
      </p>

      <p>
        That was my elevator pitch. This site, however, is my portfolio and a playground for web development. Check
        out my <a href="/projects/">projects</a> or read about my <a
          href="/experience/">experience</a
        >. Enjoy your stay!
      </p>
      <p>Och samma på finska och svenska.</p>
      <p class="signature">– Arttu :)</p>
      <nav class="contact-links" aria-label="Contact"><a href="mailto:artnikkila@gmail.com">Email ↗</a><a href="https://linkedin.com/in/arttu-nikkila" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://github.com/succabs" target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav>
    </div>

    <div class="intro-image">
      <Image src={Me} priority alt="portrait of Arttu Nikkilä" />
    </div>
  </section>

</Layout>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
