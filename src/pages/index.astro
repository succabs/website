---
// pages/index.astro
import Layout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";
import { SITE_DESCRIPTION } from "../consts";
import "@fontsource/caveat";
import { ACTION_ERROR_CODES } from "astro:actions";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "arttu.net",
  url: "https://arttu.net",
  author: {
    "@type": "Person",
    name: "Arttu Nikkilä",
    url: "https://arttu.net",
    sameAs: [
      "https://github.com/succabs",
      "https://linkedin.com/in/arttu-nikkila",
      "https://arttu.net",
    ],
  },
  description: SITE_DESCRIPTION,
};
---

<style>
  .signature {
    font-family: "Caveat", cursive;
    font-size: 2rem;
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 0;
    text-align: left;
    white-space: nowrap;
  }
  .intro {
    display: flex;
    align-items: flex-start;
    gap: 64px;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .intro-text {
    flex: 1 1 300px;
  }

  .intro-image {
    flex: 1 1 440px;
    max-width: 440px;
    padding-top: 5rem;
  }

  .intro-image img {
    width: 100%;
    height: auto;
    border-radius: 0px;
    border: 6px solid var(--color-outlines-dark);
  }

  @media (max-width: 980px) {
    .intro {
      flex-direction: column;
      align-items: center;
      text-align: left;
      gap: 32px;
    }

    .intro-image {
      flex: 1 1;
      max-width: 100%;
      padding-top: 0;
    }

    .intro-text {
      text-align: left;
      order: 2;
    }
  }

  .latest-posts {
    margin-top: 4rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    padding-top: 1rem;
  }

  .see-more {
    margin-top: 2rem;
    text-align: center;
  }

  .see-more a {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: var(--accent-second);
    text-decoration: none;
    border: 2px solid var(--accent);
    padding: 0.5em 1em;
    display: inline-block;
  }

  .see-more a:hover {
    background: var(--accent);
    color: var(--color-text);
  }
</style>
<Layout
  title="Home"
  description="Developer portfolio slash website slash digital playground of Arttu Nikkilä — experience, projects, skills, blog and personal experiments in web development."
>
  <section class="intro">
    <div class="intro-text">
      <h1>Hello / Tervetuloa.</h1>
      <p>
        I'm <strong>Arttu Nikkilä</strong>. Nice to meet you.
      </p>
      <p>
        In my current role as a <strong>developer</strong> I adapt to a wide range
        of situations deeply in the <em>client interface</em>, balancing
        technical expertise with customer-facing responsibilities in the field
        of eCommerce. I'm based in <strong>Jyväskylä, Finland</strong>.
      </p>

      <p>
        Alongside work, I'm also studying towards a Master's Degree in
        Educational Technology at the University of Jyväskylä.
      </p>

      <p>
        Outside of work and studies, I spend my time on a mix of things: from
        <a href="https://arttu.net/blog/running-with-suunto-run/">running</a> to
        reading and <a
          href="https://arttu.net/blog/why-and-how-i-started-my-dj-career/"
          >DJ'ing</a
        >.
      </p>

      <p>
        That was my elevator pitch. This website, however, is my personal
        website which is a display of my skills and a playground for me to test
        different things related to web development. Feel free to check out my <a
          href="/projects/">projects</a
        >, read about my <a href="/experience/">experience</a>, or explore the <a
          href="/blog/">blog</a
        >!
      </p>
      <p>Och samma på finska och svenska.</p>
      <p class="signature">– Arttu :)</p>
    </div>

    <div class="intro-image">
      <img src="/me.jpg" alt="portrait of Arttu Nikkilä" />
    </div>
  </section>

  <hr class="hr-4" />

  <section class="latest-posts">
    <h2>Latest Posts</h2>
    <div class="post-grid">
      {
        posts.map((post) => (
          <BlogCard
            title={post.data.title}
            date={post.data.pubDate}
            excerpt={post.data.excerpt}
            href={`/blog/${post.id}`}
            heroImage={post.data.heroImage}
            heroImageAlt={post.data.heroImageAlt}
          />
        ))
      }
    </div>
    <div class="see-more">
      <a href="/blog/">See more posts →</a>
    </div>
  </section>
</Layout>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
