---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { Image } from "astro:assets";
import ScrollTopButton from "../../components/ScrollTopButton.astro";
import "@fontsource/anton";
import "@fontsource/inter";

const wordsPerMinute = 200;

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => {
    const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
    const readTime = Math.max(1, Math.round(wordCount / wordsPerMinute));
    return {
      ...post,
      data: {
        ...post.data,
        readTime,
      },
    };
  });

const postColors = ["blue", "red"];
const allTags = Array.from(
  new Set(posts.flatMap((p) => p.data.tags ?? []))
).sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Blog"
      description="Personal blog on life, tech and curiosity — from side projects to debugging deep dives."
    />
    <style>
      /* container */
      main {
        max-width: var(--max-width);
        margin-inline: auto;
        padding-inline: 64px;
        margin-block: 64px;
      }
      @media (max-width: 720px) {
        main {
          padding-inline: 16px;
        }
      }

      /* description under page title */
      .page-description {
        margin: 0 0 1.25rem;
      }

      /* ===== toolbar (sticky) ===== */
      .controls-bar {
        position: sticky;
        top: 60px; /* adjust if your header is taller */
        z-index: 10;
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        padding: 0.6rem 0.8rem;
        background: rgba(
          37,
          117,
          185,
          0.85
        ); /* blue with slight translucency */
        backdrop-filter: blur(6px);
        border: 3px solid var(--color-outlines);
        margin: 1rem 0;
      }

      .controls-label {
        font-family: var(--font-heading);
        text-transform: uppercase;
        font-size: 0.8rem;
        margin-right: 0.5rem;
      }

      /* filter chips */
      .filter-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        align-items: center;
      }
      .filter-btn {
        font-family: var(--font-heading);
        text-transform: uppercase;
        font-size: 0.75rem;
        padding: 0.25em 0.6em;
        border: 2px solid var(--color-headings); /* cream outline on blue */
        background: transparent;
        color: var(--color-headings);
        cursor: pointer;
      }
      .filter-btn:hover {
        transform: translateY(-1px);
      }
      .filter-btn.active {
        background: var(--accent);
        border-color: var(--color-outlines);
        color: #fff;
      }

      /* sort select */
      .sort-control {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .sort-select {
        font-family: var(--font-heading);
        text-transform: uppercase;
        font-size: 0.75rem;
        padding: 0.25em 0.6em;
        border: 2px solid var(--color-headings);
        background: transparent;
        color: var(--color-headings);
      }

      /* ===== post list ===== */
      .posts-list {
        display: grid;
        gap: 2rem;
        margin-top: 1.5rem;
      }

      /* card */
      .post-item {
        position: relative;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1.25rem;
        align-items: start;

        background: var(--accent-paper);
        color: var(--color-outlines);
        border: 3px solid var(--color-outlines);
        padding: 1rem 1.25rem 1.1rem;
      }

      /* red spine */
      .post-item::before {
        content: "";
        position: absolute;
        left: -3px;
        right: -3px;
        top: -3px;
        height: 10px;
        background: var(--accent);
      }

      /* content */
      .post-content {
        max-width: 70ch;
      }
      .post-title {
        font-family: var(--font-heading);
        text-transform: uppercase;
        margin: 0.2rem 0 0.35rem;
        line-height: 1.1;
        font-size: clamp(1.25rem, 3vw, 1.6rem);
      }
      .post-title a {
        color: var(--color-outlines);
        text-decoration: underline;
        text-decoration-color: var(--color-outlines);
        text-underline-offset: 1px;
      }
      .post-title a:hover {
        text-decoration-color: var(--accent);
      }

      /* excerpt + meta */
      .post-excerpt {
        margin: 0.4rem 0 0.6rem;
        line-height: 1.6;
      }
      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.5rem;
      }
      .tag {
        border: 2px solid var(--color-outlines);
        color: var(--color-outlines);
        padding: 0.15rem 0.45rem;
        font-size: 0.8rem;
        line-height: 1.2;
        background: transparent;
      }
      .post-date {
        font-size: 0.85rem;
        margin: 0.25rem 0 0.6rem;
      }

      /* CTA */
      .read-more {
        display: inline-block;
        text-transform: uppercase;
        font-weight: 800;
        font-size: 0.85rem;
        padding: 0.4rem 0.6rem;
        border: 2px solid var(--accent);
        color: var(--accent);
        background: transparent;
        text-decoration: none;
      }
      .read-more:hover {
        background: var(--accent);
        color: #fff;
      }

      /* thumbnail */
      .post-image {
        --thumb-w: 360px;
        width: var(--thumb-w);
      }
      .post-image img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16/10;
        object-fit: cover;
        border: 3px solid var(--color-outlines);
      }

      /* pagination */
      .pagination {
        margin-top: 2rem;
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
      }
      .page-btn {
        font-family: var(--font-heading);
        font-size: 0.8rem;
        padding: 0.35em 0.6em;
        border: 2px solid var(--color-outlines);
        background: transparent;
        color: var(--accent-paper);
        cursor: pointer;
      }
      .page-btn.active {
        background: var(--accent);
        color: #fff;
        border-color: var(--color-outlines);
      }
      .page-btn[disabled] {
        opacity: 0.4;
        cursor: default;
      }
      .arrow-btn {
        font-weight: 800;
      }

      /* mobile */
      @media (max-width: 720px) {
        .controls-bar {
          position: static;
          padding: 0.5rem 0.6rem;
          flex-direction: column;
          align-items: flex-start;
        }
        .post-item {
          grid-template-columns: 1fr;
          gap: 0.9rem;
          padding: 0.9rem 0.9rem 1rem;
        }
        .post-image {
          width: 100%;
        }
      }
    </style>
  </head>
</html>
<body class="page-blog page-blue">
  <Header />
  <main class="content">
    <h1>Blog Index</h1>
    <p class="page-description full-width">
      From here you can find my occasional notes on tech, development, life and
      curious projects.
    </p>
    <hr />
    <div class="controls-bar">
      <div class="filter-buttons">
        <span class="controls-label">Filter by tag:</span>
        <button class="filter-btn active" data-tag="all">All</button>
        {
          allTags.map((tag) => (
            <button class="filter-btn" data-tag={tag}>
              {tag}
            </button>
          ))
        }
      </div>

      <div class="sort-control">
        <label for="sort-select" class="controls-label">Sort by:</label>
        <select id="sort-select" class="sort-select">
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
      </div>
    </div>

    <hr class="hr-3" />

    <section class="posts-list">
      {
        posts.map((post, idx) => (
          <article
            class={`post-item post-${postColors[idx % postColors.length]}`}
            data-tags={(post.data.tags ?? []).join(",")}
            data-date={post.data.pubDate.valueOf()}
          >
            <div class="post-content">
              <h2 class="post-title">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>

              {post.data.excerpt && (
                <p class="post-excerpt">{post.data.excerpt}</p>
              )}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="tag-list">
                  {post.data.tags.map((t) => (
                    <span class="tag" key={t}>
                      {t}
                    </span>
                  ))}
                </div>
              )}
              <p class="post-date">
                <FormattedDate date={post.data.pubDate} />
                <span class="read-time"> 🕒 {post.data.readTime} min read</span>
              </p>
              <a href={`/blog/${post.id}/`} class="read-more">
                Read More →
              </a>
            </div>
            {post.data.heroImage && (
              <div class="post-image">
                <Image
                  width={800}
                  height={450}
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt ?? post.data.title}
                />
              </div>
            )}
          </article>
        ))
      }
    </section>
    <div class="pagination"></div>
  </main>
  <div id="cookie-banner" class="cookie-banner">
    <div>
      This site uses cookies to measure traffic with Google Analytics 4. Link to
      Google's privacy policy: <a href="https://policies.google.com/privacy"
        >https://policies.google.com/privacy</a
      >.
      <div style="padding-top: 0.5rem;">
        <button id="accept-cookies" class="cookie-button">Accept</button>
        <button id="reject-cookies" class="cookie-button cancel">Cancel</button>
      </div>
    </div>
  </div>
  <Footer />
  <ScrollTopButton />

  <script type="module">
    if (typeof window !== "undefined") {
      const postsPerPage = 5;
      const postsList = document.querySelector(".posts-list");
      let posts = Array.from(document.querySelectorAll(".post-item"));
      const filterButtons = document.querySelectorAll(".filter-btn");
      const pagination = document.querySelector(".pagination");
      const sortSelect = document.getElementById("sort-select");
      let currentTag = "all";
      let currentPage = 1;
      let sortOrder = "newest";

      if (sortSelect) {
        sortSelect.addEventListener("change", () => {
          sortOrder = sortSelect.value;
          sortPosts();
          currentPage = 1;
          update();
        });
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterButtons.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          currentTag = btn.dataset.tag || "all";
          currentPage = 1;
          update();
        });
      });

      function sortPosts() {
        posts.sort((a, b) => {
          const aDate = Number(a.dataset.date);
          const bDate = Number(b.dataset.date);
          return sortOrder === "newest" ? bDate - aDate : aDate - bDate;
        });
        posts.forEach((p) => postsList.appendChild(p));
      }

      function update() {
        const visible = posts.filter((p) => {
          if (currentTag === "all") return true;
          const tags = p.dataset.tags ? p.dataset.tags.split(",") : [];
          return tags.includes(currentTag);
        });
        const totalPages = Math.max(
          1,
          Math.ceil(visible.length / postsPerPage)
        );
        pagination.innerHTML = "";

        const prev = document.createElement("button");
        prev.textContent = "\u2190";
        prev.className = "page-btn arrow-btn";
        prev.disabled = currentPage === 1;
        prev.addEventListener("click", () => {
          if (currentPage > 1) {
            currentPage--;
            update();
          }
        });
        pagination.appendChild(prev);

        for (let i = 1; i <= totalPages; i++) {
          const b = document.createElement("button");
          b.textContent = String(i);
          b.className = "page-btn" + (i === currentPage ? " active" : "");
          b.addEventListener("click", () => {
            currentPage = i;
            update();
          });
          pagination.appendChild(b);
        }

        const next = document.createElement("button");
        next.textContent = "\u2192";
        next.className = "page-btn arrow-btn";
        next.disabled = currentPage === totalPages;
        next.addEventListener("click", () => {
          if (currentPage < totalPages) {
            currentPage++;
            update();
          }
        });
        pagination.appendChild(next);
        posts.forEach((p) => (p.style.display = "none"));
        visible.forEach((p, idx) => {
          const start = (currentPage - 1) * postsPerPage;
          const end = start + postsPerPage;
          if (idx >= start && idx < end) {
            p.style.display = "";
          }
        });
      }

      sortPosts();
      update();

      const pageMap = {
        "/": "home",
        "/experience": "experience",
        "/projects": "projects",
        "/skills": "skills",
        "/about": "about",
        "/blog": "blog",
      };

      const path = window.location.pathname.replace(/\/$/, "");
      const key = pageMap[path];

      if (key) {
        const storageKey = "visitedPages";
        const stored = JSON.parse(localStorage.getItem(storageKey) || "{}");
        stored[key] = true;
        localStorage.setItem(storageKey, JSON.stringify(stored));
      }
    }
  </script>
</body><script is:inline>
  const banner = document.getElementById("cookie-banner");
  const accept = document.getElementById("accept-cookies");
  const reject = document.getElementById("reject-cookies");

  // Initialize dataLayer
  window.dataLayer = window.dataLayer || [];

  // Define gtag function
  function gtag() {
    dataLayer.push(arguments);
  }

  // Aina sivulatauksessa – jos suostumus on annettu aiemmin, päivitä consent
  if (localStorage.getItem("cookiesAccepted") === "true") {
    gtag("consent", "update", {
      ad_storage: "granted",
      analytics_storage: "granted",
    });
  }

  if (banner && localStorage.getItem("cookiesAccepted")) {
    banner.style.display = "none";
  }

  if (banner && accept && reject && !localStorage.getItem("cookiesAccepted")) {
    banner.style.display = "block";

    accept.addEventListener("click", () => {
      gtag("consent", "update", {
        ad_storage: "granted",
        analytics_storage: "granted",
      });
      localStorage.setItem("cookiesAccepted", "true");
      banner.style.display = "none";
    });

    reject.addEventListener("click", () => {
      // Ei muuta consenteja, mutta voi halutessa estää uudelleen esiin tulemisen:
      localStorage.setItem("cookiesAccepted", "rejected");
      banner.style.display = "none";
    });
  }
</script>
