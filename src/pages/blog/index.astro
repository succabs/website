---
import BaseHead from "../../components/BaseHead.astro";
import BlogListing from "../../components/BlogListing.astro";
import { getProcessedBlogPosts, getAllTags, BLOG_PAGE_SIZE } from "../../utils/blog";

const posts = await getProcessedBlogPosts();
const allTags = getAllTags(posts);
const totalPages = Math.max(1, Math.ceil(posts.length / BLOG_PAGE_SIZE));
const firstPagePosts = posts.slice(0, BLOG_PAGE_SIZE);
const pageData = {
  data: firstPagePosts,
  start: 0,
  end: firstPagePosts.length ? firstPagePosts.length - 1 : -1,
  size: BLOG_PAGE_SIZE,
  total: posts.length,
  currentPage: 1,
  lastPage: totalPages,
};
const pageDescription =
  "Personal blog on life, tech and curiosity — everything from side projects to events of my life.";
---
<html lang="en">
  <head>
    <BaseHead title="Blog" description={pageDescription} />
  </head>
  <body class="page-blog">
    <BlogListing page={pageData} allTags={allTags} />
  </body>
</html>
