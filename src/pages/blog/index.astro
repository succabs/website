---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { Image } from "astro:assets";
import ScrollTopButton from "../../components/ScrollTopButton.astro";
import "@fontsource/anton";
import "@fontsource/inter";

const wordsPerMinute = 200;

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => {
    const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
    const readTime = Math.max(1, Math.round(wordCount / wordsPerMinute));
    return {
      ...post,
      data: {
        ...post.data,
        readTime,
      },
    };
  });
const allTags = Array.from(
  new Set(posts.flatMap((p) => p.data.tags ?? []))
).sort();
---

<style>
  @media screen and (max-width: 600px) {
    .page-blog img {
      margin-top: 0.5rem;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead
      title="Blog"
      description="Personal blog on life, tech and curiosity — everything from side projects to events of my life."
    />
    <style>
      /* container */
      main {
        max-width: var(--max-width);
        margin-inline: auto;
        padding-inline: 64px;
        margin-block: 64px;
      }
      @media (max-width: 980px) {
        main {
          padding-inline: 16px;
        }
      }

      /* description under page title */
      .page-description {
        margin: 0 0 1.25rem;
      }

      /* ===== toolbar (sticky) ===== */
      .controls-bar {
        position: sticky;
        top: 60px; /* adjust if your header is taller */
        z-index: 10;
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        padding: 0.6rem 0.8rem;
        background: rgba(
          37,
          117,
          185,
          0.85
        ); /* blue with slight translucency */
        backdrop-filter: blur(6px);
        border: 3px solid var(--color-outlines-dark);
        margin: 1rem 0;
      }

      .controls-label {
        font-family: var(--font-heading);
        text-transform: uppercase;
        margin-right: 0.5rem;
      }

      /* filter chips */
      .filter-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        align-items: center;
      }
      .filter-btn {
        font-family: var(--font-heading);
        text-transform: uppercase;
        font-size: 1rem;
        padding: 0.25em 0.6em;
        border: 2px solid var(--color-headings); /* cream outline on blue */
        background: transparent;
        color: var(--color-headings);
        cursor: pointer;
      }
      .filter-btn:hover {
        transform: translateY(-1px);
      }
      .filter-btn.active {
        background: var(--accent);
        border-color: var(--color-outlines);
        color: #fff;
      }

      /* sort select */
      .sort-control {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .sort-select {
        font-family: var(--font-heading);
        text-transform: uppercase;
        font-size: 1rem;
        padding: 0.25em 0.6em;
        border: 2px solid var(--color-headings);
        background: transparent;
        color: var(--color-headings);
      }

      .sort-select,
      .filter-btn,
      .controls-bar {
        letter-spacing: 0.03em;
      }

      @media (min-width: 600px) {
        .sort-select,
        .filter-btn,
        .controls-bar {
          letter-spacing: 0.08em;
        }
      }

      /* ===== post list ===== */
      .posts-list {
        display: grid;
        gap: 2rem;
        margin-top: 1.5rem;
      }

      /* card */
      .post-item {
        position: relative;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1.25rem;
        align-items: flex-start;

        background: var(--accent-second);
        color: var(--color-text-dark);
        border: 3px solid var(--color-outlines-dark);
        padding: 2rem 1.25rem 2.1rem;
      }

      /* red spine */
      .post-item::before {
        content: "";
        position: absolute;
        left: -3px;
        right: -3px;
        top: -3px;
        height: 10px;
        background: var(--accent);
      }

      /* content */
      .post-content {
        max-width: 70ch;
      }
      .post-title {
        font-family: var(--font-heading);
        text-transform: uppercase;
        margin: 0.2rem 0 0.35rem;
        line-height: 1.1;
        font-size: clamp(1.25rem, 3vw, 1.6rem);
      }
      .post-title a {
        color: var(--color-text-dark);
        text-decoration: underline;
        text-decoration-color: var(--color-outlines-dark);
        text-underline-offset: 1px;
      }
      .post-title a:hover {
        text-decoration-color: var(--accent);
      }

      /* excerpt + meta */
      .post-excerpt {
        margin: 0.4rem 0 0.6rem;
        line-height: 1.6;
      }
      .post-date {
        font-size: 0.85rem;
        margin: 0.6rem 0 0.6rem;
      }

      /* CTA */
      .read-more {
        display: inline-block;
        text-transform: uppercase;
        font-weight: 800;
        font-size: 0.85rem;
        padding: 0.4rem 0.6rem;
        border: 2px solid var(--accent);
        color: var(--accent);
        background: transparent;
        text-decoration: none;
      }
      .read-more:hover {
        background: var(--accent);
        color: #fff;
      }

      /* thumbnail */
      .post-image {
        --thumb-w: 360px;
        width: var(--thumb-w);
      }
      .post-image img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16/10;
        object-fit: cover;
        border: 3px solid var(--color-outlines-dark);
      }

      /* pagination */
      .pagination {
        margin-top: 2rem;
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
      }
      .page-btn {
        font-family: var(--font-heading);
        font-size: 0.8rem;
        padding: 0.35em 0.6em;
        border: 2px solid var(--color-outlines-dark);
        background: transparent;
        color: var(--color-text-dark);
        cursor: pointer;
      }
      .page-btn.active {
        background: var(--accent);
        color: var(--color-text);
        border-color: var(--color-outlines);
      }
      .page-btn[disabled] {
        opacity: 0.4;
        cursor: default;
      }
      .arrow-btn {
        font-weight: 800;
      }

      /* mobile */
      @media (max-width: 980px) {
        .controls-bar {
          position: static;
          padding: 0.5rem 0.6rem;
          flex-direction: column;
          align-items: flex-start;
        }
        .post-item {
          grid-template-columns: 1fr;
          gap: 0.9rem;
          padding: 0.9rem 0.9rem 1rem;
        }
        .post-image {
          width: 100%;
        }
      }
    </style>
  </head>
</html>
<body class="page-blog">
  <Header />
  <main class="content">
    <h1>Blog Index</h1>
    <p class="page-description full-width">
      I write about my experiences as a developer, share tips and tricks I've
      learned along the way, and discuss topics that interest me — like web
      development, tracking, analytics, productivity, side projects and
      sometimes my personal hobbies. Anything goes. It's a mix of technical
      articles and personal reflections.
    </p>
    <p class="page-description full-width">
      You can browse all posts below, sort them by date, or filter them by tags
      to find topics that interest you. Have fun!
    </p>
    <hr />
    <div class="controls-bar">
      <div class="filter-buttons">
        <span class="controls-label">Filter by tag:</span>
        <button class="filter-btn active" data-tag="all">All</button>
        {
          allTags.map((tag) => (
            <button class="filter-btn" data-tag={tag}>
              {tag}
            </button>
          ))
        }
      </div>

      <div class="sort-control">
        <label for="sort-select" class="controls-label">Sort by:</label>
        <select id="sort-select" class="sort-select">
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
      </div>
    </div>

    <hr class="hr-4" />

    <section class="posts-list">
      {
        posts.map((post, idx) => (
          <article
            class={`post-item`}
            data-tags={(post.data.tags ?? []).join(",")}
            data-date={post.data.pubDate.valueOf()}
          >
            {post.data.heroImage && (
              <div class="post-image">
                <Image
                  width={800}
                  height={450}
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt ?? post.data.title}
                />
              </div>
            )}
            <div class="post-content">
              <h2 class="post-title">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>

              {post.data.excerpt && (
                <p class="post-excerpt">{post.data.excerpt}</p>
              )}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="tag-list">
                  {post.data.tags.map((t) => (
                    <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>
                      {t}
                    </a>
                  ))}
                </div>
              )}
              <p class="post-date">
                <FormattedDate date={post.data.pubDate} />
                <span class="read-time"> 🕒 {post.data.readTime} min read</span>
              </p>
              <a href={`/blog/${post.id}/`} class="read-more">
                Read The Post →
              </a>
            </div>
          </article>
        ))
      }
    </section>
    <div class="pagination"></div>
  </main>
  <Footer />
  <ScrollTopButton />

  <script type="module">
    if (typeof window !== "undefined") {
      const postsPerPage = 10;
      const postsList = document.querySelector(".posts-list");
      let posts = Array.from(document.querySelectorAll(".post-item"));
      const filterButtons = document.querySelectorAll(".filter-btn");
      const pagination = document.querySelector(".pagination");
      const sortSelect = document.getElementById("sort-select");
      let currentTag = "all";
      let currentPage = 1;
      let sortOrder = "newest";

      if (sortSelect) {
        sortSelect.addEventListener("change", () => {
          sortOrder = sortSelect.value;
          sortPosts();
          currentPage = 1;
          update();
        });
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterButtons.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          currentTag = btn.dataset.tag || "all";
          currentPage = 1;
          update();
        });
      });

      function sortPosts() {
        posts.sort((a, b) => {
          const aDate = Number(a.dataset.date);
          const bDate = Number(b.dataset.date);
          return sortOrder === "newest" ? bDate - aDate : aDate - bDate;
        });
        posts.forEach((p) => postsList.appendChild(p));
      }

      function update() {
        const visible = posts.filter((p) => {
          if (currentTag === "all") return true;
          const tags = p.dataset.tags ? p.dataset.tags.split(",") : [];
          return tags.includes(currentTag);
        });
        const totalPages = Math.max(
          1,
          Math.ceil(visible.length / postsPerPage)
        );
        pagination.innerHTML = "";

        const prev = document.createElement("button");
        prev.textContent = "\u2190";
        prev.className = "page-btn arrow-btn";
        prev.disabled = currentPage === 1;
        prev.addEventListener("click", () => {
          if (currentPage > 1) {
            currentPage--;
            update();
          }
        });
        pagination.appendChild(prev);

        for (let i = 1; i <= totalPages; i++) {
          const b = document.createElement("button");
          b.textContent = String(i);
          b.className = "page-btn" + (i === currentPage ? " active" : "");
          b.addEventListener("click", () => {
            currentPage = i;
            update();
          });
          pagination.appendChild(b);
        }

        const next = document.createElement("button");
        next.textContent = "\u2192";
        next.className = "page-btn arrow-btn";
        next.disabled = currentPage === totalPages;
        next.addEventListener("click", () => {
          if (currentPage < totalPages) {
            currentPage++;
            update();
          }
        });
        pagination.appendChild(next);
        posts.forEach((p) => (p.style.display = "none"));
        visible.forEach((p, idx) => {
          const start = (currentPage - 1) * postsPerPage;
          const end = start + postsPerPage;
          if (idx >= start && idx < end) {
            p.style.display = "";
          }
        });
      }

      sortPosts();
      update();
    }
  </script>
</body>
