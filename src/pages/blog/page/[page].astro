---
import BaseHead from "../../../components/BaseHead.astro";
import BlogListing from "../../../components/BlogListing.astro";
import {
  getProcessedBlogPosts,
  getAllTags,
  BLOG_PAGE_SIZE,
} from "../../../utils/blog";

const pageDescription =
  "Personal blog on life, tech and curiosity — everything from side projects to events of my life.";

export async function getStaticPaths({ paginate }) {
  const posts = await getProcessedBlogPosts();
  const allTags = getAllTags(posts);
  const paginatedRoutes = paginate(posts, {
    pageSize: BLOG_PAGE_SIZE,
  });

  return paginatedRoutes
    .filter((route) => route.props.page.currentPage > 1)
    .map((route) => ({
      ...route,
      props: {
        ...route.props,
        allTags,
        allPosts: posts,
      },
    }));
}

const { page, allTags, allPosts } = Astro.props;

const latestDate = allPosts
  .map((p) => p.data.updatedDate ?? p.data.pubDate)
  .sort((a, b) => b.getTime() - a.getTime())[0]
  ?.toISOString();
---

<html lang="en">
  <head>
    <BaseHead
      title={`Blog - Page ${page.currentPage}`}
      description={pageDescription}
    />
  </head>
  <body class="page-blog" data-last-update-time={latestDate}>
    <BlogListing page={page} allTags={allTags} allPosts={allPosts} />
  </body>
</html>
